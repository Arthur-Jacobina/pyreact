# Copy to deploy/langfuse/.env to override the local-dev defaults of
# docker-compose.yml (compose reads .env next to the file). Never commit .env.
# LANGFUSE_PORT=3100
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-pyreact-local
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-pyreact-local
# LANGFUSE_INIT_USER_EMAIL=dev@pyreact.local
# LANGFUSE_INIT_USER_PASSWORD=pyreact-dev-password
# SALT=change-me
# ENCRYPTION_KEY=<openssl rand -hex 32>
# NEXTAUTH_SECRET=change-me
# POSTGRES_PASSWORD=postgres
# CLICKHOUSE_PASSWORD=clickhouse
# REDIS_AUTH=myredissecret
# MINIO_ROOT_PASSWORD=miniosecret

# --- for the app / scripts/e2e_otel_langfuse.py (export these in your shell) ---
# LANGFUSE_HOST=http://localhost:3100
# LANGFUSE_PUBLIC_KEY=pk-lf-pyreact-local
# LANGFUSE_SECRET_KEY=sk-lf-pyreact-local
